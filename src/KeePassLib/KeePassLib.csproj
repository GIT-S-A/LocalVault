<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>KeePassLib</RootNamespace>
    <AssemblyName>KeePassLib</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAnalyzers>false</RunAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
    <NoWarn>$(NoWarn);CS0618;SYSLIB0001;SYSLIB0006;SYSLIB0014;SYSLIB0021;SYSLIB0022;SYSLIB0023</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../vendor/KeePassLib/**/*.cs" />
    <Compile Include="Compat.cs" />
  </ItemGroup>

</Project>
